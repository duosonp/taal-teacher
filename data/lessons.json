   "contrasts": [
    {
     "point": "Three-way systems",
     "detail": "Finnish and Gaelic distinguish near me, near you or known, and far away; Romanian, Hungarian and Swedish manage with two."
    },
    {
     "point": "Double marking",
     "detail": "Hungarian and Finnish put the case ending on both the demonstrative and the noun; Swedish and Romanian (postposed) mark definiteness twice instead: den här bilen, copilul acesta."
    },
    {
     "point": "Word order",
     "detail": "Only Gaelic places the demonstrative after the noun as the rule; Romanian allows both orders, with a change of form."
    }
   ],
   "mnemonic": "Count the distances, then ask: article? case? which side of the noun?",
